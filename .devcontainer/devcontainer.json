{
    "image": "criticalmanufacturing.io/criticalmanufacturing/devcontainer:11",
    "name": "CLI Plugins",
    "workspaceMount": "source=${localWorkspaceFolder}/..,target=/workspaces,type=bind",
    "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
    "runArgs": [],
    "features": {
        "ghcr.io/criticalmanufacturing/cli/install:1": {
            "version": "next"
        },
        "ghcr.io/criticalmanufacturing/portal-sdk/install:1": {},
        "ghcr.io/devcontainers/features/docker-in-docker": {
            "version": "28.5.2",
            "dockerDefaultAddressPool": "base=10.250.0.0/16,size=24"
        },
        "ghcr.io/devcontainers/features/powershell": {}
    },
    "mounts": [
        "source=${localEnv:HOME}${localEnv:USERPROFILE}/.cmf-auth.json,target=/home/vscode/.cmf-auth.json,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "DOCKER_REGISTRY": "docker.io",
        "CM_DOCKER_REGISTRY": "criticalmanufacturing.io",
        "cmf_cli_feature__use_repository_clients": "1",
        "FORCE_COLOR": "true",
        "DOTNET_SYSTEM_CONSOLE_ALLOW_ANSI_COLOR_REDIRECTION": "true",
        "MSBUILDTERMINALLOGGER": "true"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-azuretools.vscode-docker",
                "ms-dotnettools.csdevkit@3.10.14",
                "ms-dotnettools.csharp@2.140.9",
                "ms-dotnettools.vscode-dotnet-runtime",
                "FullStackSpider.visual-nuget",
                "actboy168.tasks",
                "eamodio.gitlens",
                "CriticalManufacturing.automation-task-library-vscode",
                "yzane.markdown-pdf",
                "ms-vscode-remote.remote-containers"
            ],
            "settings": {
                // Store credentials inside the devcontainer itself,
                // To avoid relying on the user having a functioning local docker installation
                "dev.containers.dockerCredentialHelper": false,
                // The command "cmf login sync" needs to run when the devcontainer starts,
                // but since it relies on xdg-open working a URL on the host, it cannot be
                // defined in postStartCommand or anything similar
                // See https://github.com/microsoft/vscode-remote-release/issues/9935
                "tasks": {
                    "version": "2.0.0",
                    "tasks": [
                        {
                            "label": "cmf login",
                            "type": "shell",
                            "hide": false,
                            "command": "cmf login sync",
                            "runOptions": {
                                "runOn": "folderOpen"
                            },
                            "options": {
                                "statusbar": {
                                    "label": "$(key) cmf login"
                                }
                            }
                        }
                    ]
                }
            }
        }
    },
    "forwardPorts": [
        80,
        4444
    ],
    "initializeCommand": "docker pull criticalmanufacturing.io/criticalmanufacturing/devcontainer:11-next",
    "postStartCommand": "sudo apt-get update; sudo apt-get install -y libxss1 libxdamage-dev libnss3 libcups2 libasound2t64 libatk1.0-0 libatk-bridge2.0-0 libpangocairo-1.0-0 libgtk-3-dev libsecret-1-0"
}